  '                var cnt = people.filter(function(p){return p.dept===d;}).length;',
  '                return {label:d,val:cnt,target:people.length,unit:"คน"};',
  '            });',
  '        }',
  '',
  '        /* ── Company comparison cards ── */',
  '        function pp7CompanyComparison(people){',
  '            if(people.length===0) return "";',
