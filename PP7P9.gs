  '                var detail = pp7StepDetail(s,p);',
  '                h += "<div class=\\"pp7-tl-item "+status+"\\"><div class=\\"pp7-tl-card "+status+"\\"><div class=\\"pp7-tl-title\\">"+PP7_STEP_ICONS[i]+" "+PP7_STEP_NAMES[i]+" <span class=\\"pp7-tl-status "+status+"\\">"+statusLabel+"</span></div><div class=\\"pp7-tl-detail\\">"+detail+"</div></div></div>";',
  '            });',
  '            h += "</div>";',
  '            h += "</div>";',
  '            return h;',
  '        }',
  '',
  '        function pp7JourneyStat(label,val){',
  '            return "<div class=\\"pp7-journey-stat\\"><div class=\\"js-lbl\\">"+label+"</div><div class=\\"js-val\\">"+val+"</div></div>";',
  '        }',
  '',
  '        function pp7StepDetail(step,p){',
  '            var d = {',
  '                p1:"สมัครงานเมื่อ "+pp7FmtDate(p.appliedDate)+" | AI Score: "+p.aiScore+"%",',
  '                p2:"CC Score: "+p.ccScore.toFixed(1)+" คะแนน (7 ด้าน) | ผ่านเกณฑ์: "+(p.ccScore>=3.0?"✅":"❌"),',
  '                p3:"Match Score: "+p.matchScore+"% | ตำแหน่ง: "+p.position+" | แผนก: "+p.dept,',
  '                p4:"KPI Score: "+(p.kpiScore?p.kpiScore.toFixed(1):"-")+" | ผลประเมิน: "+(p.kpiScore>=3.5?"ผ่าน":"รอพัฒนา"),',
  '                p5:"ชม.อบรม: "+p.training+" ชม. | Dev Progress: "+p.devProgress+"% | IDP: "+(p.p5==="completed"?"ครบ":"กำลังดำเนิน"),',
  '                p6:"เงินเดือน: "+(p.salary?p.salary.toLocaleString()+"฿":"-")+" | โบนัส: "+(p.bonus?p.bonus.toLocaleString()+"฿":"-"),',
  '                p7:"Engagement: "+(p.engagement?p.engagement+"%":"-")+" | คุณภาพชีวิต: "+(p.p7==="completed"?"สมดุล":"รอประเมิน")',
  '            };',
  '            return d[step]||"";',
  '        }',
  '',
  '        function pp7StatusShort(s){',
  '            if(s==="completed") return "✅";',
  '            if(s==="in_progress") return "🔄";',
  '            return "⏳";',
  '        }',
  '',
  '        function pp7FmtDate(d){',
  '            var parts = d.split("-");',
  '            var m = parseInt(parts[1])-1;',
  '            return PP7_MONTH_NAMES[m]+" "+parts[0];',
  '        }',
  '',
  '        /* ── Select person from table ── */',
  '        function pp7SelectPerson(tabName,personId){',
  '            pp7Filter.person = personId;',
  '            var sel = document.getElementById("pp7-fp-"+tabName);',
  '            if(sel) sel.value = personId;',
  '            pp7RenderTab(tabName);',
  '        }',
  '',
  '        /* ── Inject filter bar before dashboard ── */',
  '        var _pp7FilterInjected = {};',
  '        function pp7InjectFilterBar(tabName){',
  '            var dashId = {recruit:"p1-dashboard",assess:"p2-dashboard",match:"p3-dashboard",performance:"p4-dashboard",develop:"p5-dashboard",welfare:"p6-dashboard",quality:"p7-dashboard"}[tabName];',
  '            if(!dashId || _pp7FilterInjected[dashId]) return;',
  '            var dash = document.getElementById(dashId);',
  '            if(!dash) return;',
  '            pp7InjectCSS();',
  '            var bar = document.createElement("div");',
  '            bar.innerHTML = pp7BuildFilterBar(tabName);',
  '            var filterBar = bar.firstChild;',
  '            dash.parentNode.insertBefore(filterBar, dash);',
  '            _pp7FilterInjected[dashId] = true;',
  '        }',
  '',
  '        /* ── Poll for active tab and inject filter bar + render ── */',
  '        /* NO showTab override — uses setInterval polling instead */',
  '        var _pp7CurrentTab = null;',
  '        var _pp7PollCount = 0;',
  '        var _pp7TabIds = ["recruit","assess","match","performance","develop","welfare","quality"];',
  '',
  '        function pp7DetectActiveTab(){',
  '            for(var i=0; i<_pp7TabIds.length; i++){',
  '                var t = _pp7TabIds[i];',
  '                var el = document.getElementById(t+"-tab");',
  '                if(el){',
  '                    var cls = el.className || "";',
  '                    var parent = el.parentElement;',
  '                    var parentCls = parent ? (parent.className||"") : "";',
  '                    /* Check if this tab is active */',
  '                    if(cls.indexOf("active")>=0 || parentCls.indexOf("active")>=0){',
  '                        return t;',
  '                    }',
  '                }',
  '            }',
  '            return null;',
  '        }',
  '',
  '        function pp7PollAndRender(){',
  '            _pp7PollCount++;',
  '            var activeTab = pp7DetectActiveTab();',
  '            if(activeTab && activeTab !== _pp7CurrentTab){',
  '                _pp7CurrentTab = activeTab;',
  '                /* Tab changed — inject filter bar and render */',
  '                setTimeout(function(){',
  '                    pp7InjectFilterBar(activeTab);',
  '                    var dashId = {recruit:"p1-dashboard",assess:"p2-dashboard",match:"p3-dashboard",performance:"p4-dashboard",develop:"p5-dashboard",welfare:"p6-dashboard",quality:"p7-dashboard"}[activeTab];',
  '                    if(dashId) _pp7DashRendered[dashId] = false;',
  '                    pp7RenderTab(activeTab);',
  '                }, 50);',
  '            }',
  '            /* Also check if filter bar is missing (e.g. after first load) */',
  '            if(activeTab){',
  '                var dashId = {recruit:"p1-dashboard",assess:"p2-dashboard",match:"p3-dashboard",performance:"p4-dashboard",develop:"p5-dashboard",welfare:"p6-dashboard",quality:"p7-dashboard"}[activeTab];',
  '                if(dashId && !_pp7FilterInjected[dashId]){',
  '                    pp7InjectFilterBar(activeTab);',
  '                    pp7RenderTab(activeTab);',
  '                }',
  '            }',
  '        }',
  '',
  '        /* Start polling after page load */',
  '        if(document.readyState === "loading"){',
  '            document.addEventListener("DOMContentLoaded", function(){',
  '                pp7InjectCSS();',
  '                setInterval(pp7PollAndRender, 500);',
  '            });',
  '        } else {',
  '            pp7InjectCSS();',
  '            setInterval(pp7PollAndRender, 500);',
