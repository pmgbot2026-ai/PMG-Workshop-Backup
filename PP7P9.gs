  '            var h = "";',
  '            h += "<div style=\\"margin-bottom:12px;font-size:.85rem;color:#475569\\">เลือกบุคคลจากดรอปดาวน์ด้านบนเพื่อดู P1-P7 Journey หรือคลิกที่แถวในตารางด้านล่าง</div>";',
  '            h += "<div class=\\"pp7-scroll\\"><table class=\\"pp7-person-table\\"><thead><tr><th>รหัส</th><th>ชื่อ</th><th>บริษัท</th><th>แผนก</th><th>ตำแหน่ง</th><th>วันสมัคร</th><th>P1</th><th>P2</th><th>P3</th><th>P4</th><th>P5</th><th>P6</th><th>P7</th><th>CC</th><th>Match</th><th>KPI</th><th>AI</th><th>Eng</th></tr></thead><tbody>";',
