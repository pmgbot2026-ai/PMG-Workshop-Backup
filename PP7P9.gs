  '                    if(m!==pp7Filter.month) return false;',
  '                }',
  '                if(pp7Filter.year!=="all"){',
  '                    var y = p.appliedDate.split("-")[0];',
  '                    if(y!==pp7Filter.year) return false;',
  '                }',
  '                if(pp7Filter.person!=="all" && p.id!==pp7Filter.person) return false;',
  '                return true;',
  '            });',
  '        }',
