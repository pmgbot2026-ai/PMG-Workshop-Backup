  '            h += "<div style=\\"margin-left:auto;text-align:right\\"><div style=\\"font-size:1.5rem;font-weight:800;color:"+colorCode+"\\">"+overallPct+"%</div><div style=\\"font-size:.7rem;color:#64748b\\">เสร็จสิ้น "+completedCount+"/7 ขั้น</div></div></div>";',
