  '                var cp = people.filter(function(p){return p.company===co;});',
  '                if(cp.length===0) return;',
  '                var avgCC = (cp.reduce(function(s,p){return s+p.ccScore;},0)/cp.length).toFixed(1);',
  '                var avgMatch = Math.round(cp.reduce(function(s,p){return s+p.matchScore;},0)/cp.length);',
  '                var avgEng = Math.round(cp.reduce(function(s,p){return s+p.engagement;},0)/cp.length);',
  '                var completed = cp.filter(function(p){return p.p7==="completed";}).length;',
  '                h += "<div class=\\"pp7-comp-card\\"><h4>"+co+" ("+cp.length+" คน)</h4>";',
  '                h += "<div class=\\"pp7-comp-val\\">"+avgMatch+"%</div>";',
  '                h += "<div style=\\"font-size:.7rem;color:#64748b;margin-top:4px\\">Match เฉลี่ย</div>";',
  '                h += "<div style=\\"font-size:.72rem;color:#475569;margin-top:6px\\">CC: "+avgCC+" | Eng: "+avgEng+"%</div>";',
  '                h += "<div style=\\"font-size:.72rem;color:#10b981;margin-top:2px\\">ครบ P7: "+completed+" คน</div></div>";',
  '            });',
  '            h += "</div>";',
  '            return h;',
  '        }',
  '',
  '        /* ── Individual Journey View ── */',
  '        function pp7RenderIndividualView(tabName,people){',
  '            if(people.length===0) return "<p style=\\"text-align:center;color:#64748b;padding:20px\\">ไม่มีข้อมูลตามตัวกรองที่เลือก</p>";',
  '            /* If specific person selected, show their journey */',
