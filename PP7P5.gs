  '                    app.history.push({ action: \'นัดเริ่มงาน\', timestamp: new Date().toISOString(), note: `วันเริ่มงาน: ${startDate}` });',
  '                    saveApplicantData(app);',
  '                    alert(`✅ นัดเริ่มงานแล้ว!\\n\\nวันเริ่มงาน: ${startDate}`);',
