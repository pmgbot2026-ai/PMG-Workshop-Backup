  '                }',
  '            }',
  '        }',
  '',
  '        function saveApplicantData(app) {',
  '            // ตรวจสอบว่าเป็นข้อมูลตั้งต้นหรือข้อมูลใหม่',
  '            const initial = JSON.parse(localStorage.getItem(\'pkg_initial_applicants\') || \'[]\');',
  '            const newApps = JSON.parse(localStorage.getItem(\'pkg_applications\') || \'[]\');',
  '            ',
  '            const initialIndex = initial.findIndex(a => a.id === app.id);',
  '            if (initialIndex !== -1) {',
  '                // เป็นข้อมูลตั้งต้น',
  '                initial[initialIndex] = app;',
  '                localStorage.setItem(\'pkg_initial_applicants\', JSON.stringify(initial));',
  '            } else {',
  '                // เป็นข้อมูลใหม่',
  '                const newIndex = newApps.findIndex(a => a.id === app.id);',
  '                if (newIndex !== -1) {',
  '                    newApps[newIndex] = app;',
  '                } else {',
  '                    newApps.push(app);',
  '                }',
  '                localStorage.setItem(\'pkg_applications\', JSON.stringify(newApps));',
  '            }',
  '        }',
  '',
