  '',
  '        function screenApplicant(appId) {',
  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                app.status = \'screened\';',
  '                app.history.push({ action: \'คัดกรอง\', timestamp: new Date().toISOString(), note: \'HR คัดกรองผ่าน\' });',
  '                saveApplicantData(app);',
  '                alert(\'✅ คัดกรองผู้สมัครแล้ว!\');',
  '                renderHRView();',
  '            }',
  '        }',
  '',
  '        function scheduleInterview(appId) {',
  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                const date = prompt(\'วันที่สัมภาษณ์ (เช่น 25/07/2569):\', \'25/07/2569\');',
  '                const time = prompt(\'เวลาสัมภาษณ์ (เช่น 10:00 น.):\', \'10:00 น.\');',
  '                if (date && time) {',
  '                    app.status = \'interview_scheduled\';',
  '                    app.interviewDate = date;',
  '                    app.interviewTime = time;',
  '                    app.history.push({ action: \'นัดสัมภาษณ์\', timestamp: new Date().toISOString(), note: `วันที่ ${date} เวลา ${time}` });',
  '                    saveApplicantData(app);',
  '                    alert(`✅ นัดสัมภาษณ์แล้ว!\\n\\nวันที่: ${date}\\nเวลา: ${time}`);',
  '                    renderHRView();',
  '                }',
  '            }',
  '        }',
  '',
  '        function markInterviewed(appId) {',
  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                // แสดงฟอร์มสัมภาษณ์',
  '                const interviewNotes = prompt(\'บันทึกผลการสัมภาษณ์ (เช่น ผ่าน/ไม่ผ่าน/สำรอง):\', \'ผ่าน - มีศักยภาพดี\');',
  '                if (interviewNotes !== null) {',
  '                    app.status = \'interviewed\';',
  '                    app.interviewNotes = interviewNotes;',
  '                    app.history.push({ action: \'สัมภาษณ์\', timestamp: new Date().toISOString(), note: interviewNotes });',
  '                    saveApplicantData(app);',
  '                    alert(\'✅ บันทึกผลการสัมภาษณ์แล้ว!\\n\\n\' + interviewNotes);',
  '                    renderHRView();',
  '                }',
  '            }',
  '        }',
  '',
  '        function finalizeResult(appId) {',
  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                app.status = \'hired\';',
  '                app.history.push({ action: \'สรุปผล\', timestamp: new Date().toISOString(), note: \'ผ่านคัดเลือก\' });',
  '                saveApplicantData(app);',
  '                alert(\'✅ สรุปผล: ผ่าน!\');',
  '                renderHRView();',
  '            }',
  '        }',
  '',
  '        function onboard(appId) {',
  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                const startDate = prompt(\'วันเริ่มงาน (เช่น 01/08/2569):\', \'01/08/2569\');',
  '                if (startDate) {',
  '                    app.status = \'onboarded\';',
