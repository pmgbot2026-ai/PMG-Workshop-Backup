  '            const applications = getAllApplicants();',
  '            const app = applications.find(a => a.id === appId);',
  '            if (app) {',
  '                let detail = `📋 รายละเอียดผู้สมัคร\\n\\n`;',
  '                detail += `รหัส: ${app.id}\\n`;',
  '                detail += `ชื่อ: ${app.firstName} ${app.lastName}\\n`;',
  '                if (app.phone) detail += `เบอร์: ${app.phone}\\n`;',
  '                if (app.email) detail += `Email: ${app.email}\\n`;',
  '                detail += `ตำแหน่ง: ${app.position}\\n`;',
  '                detail += `แผนก: ${app.department}\\n`;',
  '                detail += `สาขา: ${app.branch}\\n`;',
  '                if (app.education) detail += `วุฒิ: ${app.education}\\n`;',
  '                if (app.major) detail += `สาขาวิชา: ${app.major}\\n`;',
  '                if (app.skills) detail += `ทักษะ: ${app.skills}\\n`;',
  '                if (app.experience) detail += `ประสบการณ์: ${app.experience} ปี\\n`;',
