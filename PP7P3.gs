  '                                <p class="text-lg font-semibold">${aiResult.isSuitable ? \'✅ เหมาะสมกับตำแหน่งนี้\' : \'⚠️ ยังไม่เหมาะสมกับตำแหน่งนี้\'}</p>',
  '                            </div>',
  '                            <div class="text-6xl opacity-50">${aiResult.isSuitable ? \'✅\' : \'⚠️\'}</div>',
  '                        </div>',
  '                    </div>',
  '',
  '                    <div class="mb-6">',
  '                        <h3 class="text-lg font-semibold text-gray-700 mb-4"><i class="fas fa-list-check mr-2"></i>รายละเอียดการวิเคราะห์</h3>',
  '                        <div class="space-y-2">${aiResult.reasons.map(r => `<div class="bg-gray-50 p-3 rounded-lg"><p class="text-sm">${r}</p></div>`).join(\'\')}</div>',
  '                    </div>',
  '',
  '                    ${aiResult.suggestions.length > 0 ? `<div class="mb-6"><h3 class="text-lg font-semibold text-gray-700 mb-4"><i class="fas fa-lightbulb mr-2"></i>ข้อเสนอแนะ</h3><div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-lg"><ul class="text-sm text-yellow-800 space-y-1">${aiResult.suggestions.map(s => `<li>→ ${s}</li>`).join(\'\')}</ul></div></div>` : \'\'}',
  '',
  '                    ${aiResult.isSuitable ? `',
  '                        <div class="bg-green-50 border-l-4 border-green-400 p-4 rounded-lg mb-6">',
  '                            <div class="flex items-start"><div class="text-green-600 mr-2 mt-1">✅</div><div><p class="font-semibold text-green-800 mb-1">ยินดีด้วย! คุณสมบัติของคุณเหมาะสมกับตำแหน่งนี้</p><p class="text-sm text-green-700">ขั้นตอนถัดไป: ทำแบบทดสอบ 4 ชุด เพื่อประเมินศักยภาพ</p></div></div>',
  '                        </div>',
  '                        <button onclick="startTest()" class="w-full bg-purple-600 text-white py-3 rounded-lg hover:bg-purple-700 transition font-semibold"><i class="fas fa-tasks mr-2"></i>เริ่มทำแบบทดสอบ</button>',
  '                    ` : `',
  '                        <div class="flex space-x-4">',
  '                            <button onclick="backToPositions()" class="flex-1 bg-gray-300 text-gray-700 py-3 rounded-lg hover:bg-gray-400 transition">← เลือกตำแหน่งอื่น</button>',
  '                            <button onclick="switchView(\'hr\')" class="flex-1 bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 transition">👔 ดูมุมมอง HR</button>',
  '                        </div>',
  '                    `}',
  '                </div>',
  '            `;',
  '        }',
  '',
  '        // ===== STEP 4: TEST =====',
  '        function startTest() {',
  '            currentStep = \'test\';',
  '            currentTest = \'attitude\';',
  '            currentQuestion = 0;',
  '            testAnswers = { attitude: {}, skill: {}, cc: {}, e3p: {} };',
  '            renderTestView();',
  '        }',
  '',
  '        function renderTestView() {',
  '            const content = document.getElementById(\'content-area\');',
  '            const test = TESTS[currentTest];',
  '            const question = test.questions[currentQuestion];',
  '            const totalQuestions = Object.values(TESTS).reduce((sum, t) => sum + t.questions.length, 0);',
  '            const answeredQuestions = Object.values(testAnswers).reduce((sum, t) => sum + Object.keys(t).length, 0);',
  '            const progress = (answeredQuestions / totalQuestions) * 100;',
  '            ',
  '            content.innerHTML = `',
  '                <div class="bg-white rounded-xl shadow-lg p-6">',
  '                    <div class="flex justify-between items-center mb-6">',
  '                        <h2 class="text-2xl font-bold text-gray-800"><i class="fas fa-tasks text-purple-600 mr-2"></i>แบบทดสอบ</h2>',
  '                        <div class="text-sm text-gray-600">ความคืบหน้า: ${Math.round(progress)}%</div>',
  '                    </div>',
  '                    <div class="w-full bg-gray-200 rounded-full h-3 mb-6"><div class="bg-purple-600 h-3 rounded-full" style="width: ${progress}%"></div></div>',
  '                    ',
  '                    <div class="flex space-x-2 mb-6">',
  '                        ${Object.keys(TESTS).map(key => `',
  '                            <button onclick="switchTest(\'${key}\')" class="flex-1 py-2 rounded-lg text-sm font-semibold ${key === currentTest ? \'bg-purple-600 text-white\' : \'bg-gray-200 text-gray-700\'}">',
  '                                <i class="fas ${TESTS[key].icon} mr-1"></i>${TESTS[key].title}',
  '                            </button>',
  '                        `).join(\'\')}',
  '                    </div>',
  '',
  '                    <div class="mb-6">',
  '                        <div class="flex justify-between items-center mb-4">',
  '                            <h3 class="text-lg font-semibold text-gray-800">${test.title} - ข้อ ${currentQuestion + 1}/${test.questions.length}</h3>',
  '                            <span class="text-sm text-gray-500">เวลา: ${test.time} นาที</span>',
  '                        </div>',
  '                        <div class="bg-purple-50 border-l-4 border-purple-600 p-4 rounded-lg mb-6">',
  '                            <p class="text-gray-800 font-medium">${question.text}</p>',
  '                        </div>',
  '                        <div class="space-y-3">',
  '                            ${question.options.map((opt, idx) => `',
  '                                <div class="option-card border-2 border-gray-200 rounded-lg p-4 ${testAnswers[currentTest][question.id] === idx + 1 ? \'selected\' : \'\'}" onclick="selectAnswer(\'${currentTest}\', \'${question.id}\', ${idx + 1})">',
  '                                    <div class="flex items-center">',
  '                                        <div class="w-8 h-8 rounded-full border-2 ${testAnswers[currentTest][question.id] === idx + 1 ? \'bg-white text-purple-600\' : \'border-gray-300\'} flex items-center justify-center font-semibold mr-3">${String.fromCharCode(65 + idx)}</div>',
  '                                        <span class="flex-1">${opt}</span>',
  '                                    </div>',
  '                                </div>',
  '                            `).join(\'\')}'
];
