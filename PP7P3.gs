  '                    <p class="text-gray-600 mb-6">ตำแหน่ง: <strong>${selectedPosition.title}</strong></p>',
  '                    ',
  '                    <div class="bg-gradient-to-r ${aiResult.isSuitable ? \'from-green-500 to-green-600\' : \'from-orange-500 to-orange-600\'} text-white p-6 rounded-xl mb-6">',
