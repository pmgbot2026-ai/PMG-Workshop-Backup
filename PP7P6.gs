  '                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">',
  '                        ${candidates.map(app => `',
  '                            <div class="border-2 border-gray-200 rounded-xl p-4 card-hover cursor-pointer hover:border-emerald-500" onclick="startP3Match(\'${app.id}\')">',
  '                                <div class="flex items-center gap-3 mb-3">',
  '                                    <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center text-xl font-bold text-emerald-600">${app.firstName.charAt(0)}</div>',
  '                                    <div>',
  '                                        <h3 class="font-bold text-gray-800">${app.firstName} ${app.lastName}</h3>',
  '                                        <p class="text-xs text-gray-500">${app.position || \'ไม่ระบุ\'}</p>',
  '                                    </div>',
  '                                </div>',
  '                                ${app.ccScores ? `',
  '                                    <div class="mb-2">',
  '                                        <div class="text-xs text-gray-600 mb-1">CC Score: <strong class="text-purple-600">${calcCCOverall(app.ccScores)}</strong></div>',
  '                                        <div class="w-full bg-gray-200 rounded-full h-2"><div class="bg-purple-600 h-2 rounded-full" style="width:${calcCCOverall(app.ccScores)}%"></div></div>',
  '                                    </div>',
  '                                    <div class="flex flex-wrap gap-1">',
  '                                        ${CC_DIMENSIONS.map(cc => `<span class="text-xs px-1.5 py-0.5 rounded" style="background:${cc.color}20;color:${cc.color}">${cc.key}:${app.ccScores[cc.key]}</span>`).join(\'\')}',
  '                                    </div>',
  '                                ` : \'\'}',
  '                                <div class="mt-3 text-xs text-emerald-600 font-semibold">🎯 คลิกเพื่อจับคู่ตำแหน่ง</div>',
  '                            </div>',
  '                        `).join(\'\')}',
  '                    </div>`}',
  '                </div>',
  '                <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-xl p-6 border border-emerald-200">',
  '                    <h3 class="font-bold text-gray-800 mb-3">📋 ตำแหน่งงานที่เปิดรับ (${P3_JOB_POSITIONS.length} ตำแหน่ง)</h3>',
  '                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">',
  '                        ${P3_JOB_POSITIONS.map(job => `',
  '                            <div class="bg-white p-3 rounded-lg shadow-sm">',
  '                                <div class="font-bold text-gray-800 text-sm">${job.title}</div>',
  '                                <div class="text-xs text-gray-500">${job.department} | ${job.level} | ${job.salary} ฿</div>',
  '                            </div>',
  '                        `).join(\'\')}',
  '                    </div>',
  '                </div>',
  '            `;',
  '        }',
  '',
  '        function startP3Match(appId) {',
  '            const all = getAllApplicants();',
  '            const app = all.find(a => a.id === appId);',
  '            if (!app || !app.ccScores) return;',
