  '',
  '                    <h3 class="text-xl font-bold text-gray-800 mb-4"><i class="fas fa-trophy text-amber-500 mr-2"></i>Top 3 ตำแหน่งที่เหมาะสม</h3>',
  '                    <div class="space-y-4 mb-6">',
  '                        ${topMatches.map((job, idx) => {',
  '                            const medals = [\'🥇\',\'🥈\',\'🥉\'];',
  '                            const colors = [\'from-amber-400 to-amber-500\',\'from-gray-300 to-gray-400\',\'from-amber-600 to-amber-700\'];',
  '                            return `',
  '                            <div class="border-2 ${idx===0?\'border-amber-400 bg-amber-50\':\'border-gray-200\'} rounded-xl p-5">',
  '                                <div class="flex items-center justify-between mb-3">',
  '                                    <div class="flex items-center gap-3">',
  '                                        <span class="text-3xl">${medals[idx]}</span>'
];
