  '                    <div class="flex items-center gap-4 mb-6">',
  '                        <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center text-2xl font-bold text-emerald-600">${app.firstName.charAt(0)}</div>',
  '                        <div>',
  '                            <h2 class="text-2xl font-bold text-gray-800">${app.firstName} ${app.lastName}</h2>',
  '                            <p class="text-gray-600">CC Score: <strong class="text-purple-600">${calcCCOverall(app.ccScores)}</strong> | ประสบการณ์: ${app.experience || 0} ปี</p>',
  '                        </div>',
